# SITE_ADDRESS dolazi iz .env:
#   :80              -> HTTP na golom IP-u (nema domene)
#   artconnect.hr    -> Caddy sam dobije HTTPS certifikat
{$SITE_ADDRESS::80} {
	encode gzip

	# Isti putovi kao u frontend/vite.config.ts (proxy u razvoju)
	@backend path /api/* /oauth2/* /login/oauth2/* /actuator/*
	handle @backend {
		reverse_proxy backend:8080
	}

	# Frontend (SPA): sve ostalo vraća index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
